---
// ╭──────────────────────────────────────────────────────────────────────────╮
// │                                                                          │
// │   G A L L E R Y                                                          │
// │   several pictures by name, in a grid · each full size on a click        │
// │                                                                          │
// │   github.com/andreumassanet/impasto-docs                                 │
// │                                                                          │
// ╰──────────────────────────────────────────────────────────────────────────╯

import { Image, getImage } from 'astro:assets';
import { findShot } from '~/data/shots';

interface Item {
	name: string;
	alt: string;
	caption?: string;
}

interface Props {
	items: Item[];
	/** Columns at full width; fewer on a narrow screen. */
	columns?: 2 | 3 | 4;
}

const { items, columns = 2 } = Astro.props;
const cells = await Promise.all(
	items.map(async (item) => {
		const { image, animated } = findShot(item.name);
		const full = animated
			? image.src
			: (await getImage({ src: image, width: Math.min(image.width, 2800), format: 'webp', quality: 82 })).src;
		return { ...item, image, animated, full };
	}),
);
const sizes = `(min-width: 72rem) ${Math.round(46 / columns)}rem, ${columns > 2 ? 50 : 100}vw`;
---

<div class="gallery not-content" style={`--columns: ${columns}`}>
	{
		cells.map((cell) => (
			<figure>
				<button type="button" class="zoom" data-full={cell.full} data-caption={cell.caption} aria-label={`Enlarge: ${cell.alt}`}>
					{cell.animated ? (
						<img src={cell.image.src} width={cell.image.width} height={cell.image.height} alt={cell.alt} loading="lazy" decoding="async" />
					) : (
						<Image src={cell.image} alt={cell.alt} widths={[400, 800, 1200]} sizes={sizes} />
					)}
				</button>
				{cell.caption && <figcaption>{cell.caption}</figcaption>}
			</figure>
		))
	}
</div>

<script>
	import '~/scripts/lightbox';
</script>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		gap: 1.25rem 1rem;
		margin-block: 1.75rem;
	}
	@media (max-width: 40rem) {
		.gallery {
			grid-template-columns: repeat(min(var(--columns), 2), minmax(0, 1fr));
		}
	}
	figure {
		margin: 0;
	}
	.zoom {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.zoom :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-medium);
		background: var(--island);
		transition: transform 0.2s ease;
	}
	.zoom:hover :global(img) {
		transform: translateY(-2px);
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		line-height: 1.45;
		color: var(--sl-color-gray-3);
	}
	@media (prefers-reduced-motion: reduce) {
		.zoom :global(img) {
			transition: none;
		}
	}
</style>
