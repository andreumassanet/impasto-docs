---
// ╭──────────────────────────────────────────────────────────────────────────╮
// │                                                                          │
// │   P A L E T T E D E M O                                                  │
// │   a few wallpapers, the nine palettes · and the tokens they produce      │
// │                                                                          │
// │   github.com/andreumassanet/impasto-docs                                 │
// │                                                                          │
// ╰──────────────────────────────────────────────────────────────────────────╯

import { loadPaint, DEFAULT_WALLPAPER } from '~/data/paint';

const { wallpapers, palettes } = await loadPaint();
const first = wallpapers.find((wall) => wall.id === DEFAULT_WALLPAPER)!;

// Eight wallpapers spread round the colour wheel by their accent's hue.
const hue = (hex: string) => {
	const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
	const max = Math.max(r, g, b);
	const d = max - Math.min(r, g, b);
	if (!d) return 0;
	const h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
	return (h * 60 + 360) % 360;
};
const byHue = [...wallpapers].sort((a, b) => hue(a.palette.accent) - hue(b.palette.accent));
const sample = [first, ...Array.from({ length: 7 }, (_, i) => byHue[Math.floor(((i + 0.5) * byHue.length) / 7)])]
	.filter((wall, index, all) => all.indexOf(wall) === index);

// The shell's own token families, in the order its Theme lists them.
const families = [
	{ name: 'Surfaces', tokens: [['background', '--p-bg'], ['surface', '--p-surface'], ['surfaceHover', '--p-surface-hover'], ['border', '--p-border']] },
	{ name: 'Type', tokens: [['text', '--p-text'], ['textMuted', '--p-muted']] },
	{ name: 'Accent', tokens: [['accent', '--p-accent'], ['accentHover', '--p-accent-hover'], ['accentText', '--p-accent-text']] },
	{ name: 'Status', tokens: [['red', '--p-red'], ['green', '--p-green'], ['yellow', '--p-yellow'], ['blue', '--p-blue']] },
];
---

<div class="paint-demo not-content">
	<div class="walls" role="group" aria-label="Wallpapers">
		{
			sample.map((wall) => (
				<button type="button" data-paint={`wallpaper:${wall.id}`} aria-label={wall.name} title={wall.name}>
					<img src={wall.thumb} alt="" width="120" height="75" loading="lazy" decoding="async" />
				</button>
			))
		}
	</div>
	<div class="palettes" role="group" aria-label="Palettes">
		{
			palettes.map((palette) => (
				<button type="button" data-paint={`palette:${palette.id}`}>
					<span class="dots" aria-hidden="true">
						{palette.swatches.map((colour) => (
							<span style={`background:${colour}`} />
						))}
					</span>
					{palette.name}
				</button>
			))
		}
	</div>
	<p class="now">Showing <strong data-paint-name>{first.name}</strong></p>
	<div class="families">
		{
			families.map((family) => (
				<div class="family">
					<p class="family-name">{family.name}</p>
					<dl class="tokens">
						{family.tokens.map(([name, variable]) => (
							<div>
								<dt>
									<span class="chip" style={`background: var(${variable})`} />
									{name}
								</dt>
								<dd data-token={name}>{first.palette[name].toLowerCase()}</dd>
							</div>
						))}
					</dl>
				</div>
			))
		}
	</div>
</div>

<script>
	import '~/scripts/paint';
</script>

<style>
	.paint-demo {
		display: grid;
		gap: 1rem;
		margin-block: 1.75rem;
	}
	.walls {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.walls button {
		aspect-ratio: 16 / 10;
		padding: 0;
		border: 0;
		border-radius: 0.7rem;
		overflow: hidden;
		background: var(--island);
		cursor: pointer;
	}
	.walls img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.walls button[aria-pressed='true'] {
		outline: 2px solid var(--p-text);
		outline-offset: 2px;
	}
	.palettes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.palettes button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.8rem 0.35rem 0.55rem;
		border: 1px solid var(--island-border);
		border-radius: 999px;
		background: var(--island);
		color: #d4d4d4;
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
	}
	.palettes button:hover,
	.palettes button[aria-pressed='true'] {
		color: #fff;
		border-color: #8a8a8a;
	}
	.dots {
		display: inline-flex;
	}
	.dots span {
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		border: 1.5px solid var(--island);
	}
	.dots span + span {
		margin-left: -0.3rem;
	}
	.now {
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
		color: var(--p-muted);
	}
	.now strong {
		color: var(--p-text);
		font-weight: 600;
	}
	.families {
		display: grid;
		gap: 0.9rem;
	}
	.family-name {
		margin: 0 0 0.4rem;
		font-size: 0.8rem;
		font-weight: 650;
		color: var(--p-muted);
	}
	.tokens {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0;
	}
	@media (max-width: 36rem) {
		.tokens {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.tokens div {
		padding: 0.6rem 0.7rem;
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--p-surface) 55%, transparent);
		border: 1px solid color-mix(in oklab, var(--p-border) 65%, transparent);
	}
	dt {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--p-text);
	}
	.chip {
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		border-radius: 0.4rem;
		box-shadow: inset 0 0 0 1px rgb(128 128 128 / 0.35);
	}
	dd {
		margin: 0.3rem 0 0 1.9rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--p-muted);
	}
</style>
